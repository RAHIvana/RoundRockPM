# ---- Vertex AI (Gemini) -----------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
CHAT_ENABLED=true

# ---- Who may call this service ---------------------------------------------
ALLOWED_ORIGINS=https://roundrockpm.com,https://www.roundrockpm.com

# ---- Where leads go ---------------------------------------------------------
OFFICE_EMAIL=support@roundrockpm.com
OFFICE_PHONE=(512) 919-6250

# SMTP. Gmail/Workspace: smtp.gmail.com:587 with an App Password (not your
# normal password). SendGrid: smtp.sendgrid.net:587, user "apikey".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@roundrockpm.com
SMTP_PASS=put-this-in-secret-manager
SMTP_FROM=support@roundrockpm.com

# ---- Optional: DoorLoop listings proxy --------------------------------------
# Leave blank unless you want /api/listings to serve live DoorLoop data.
DOORLOOP_API_KEY=
DOORLOOP_BASE_URL=https://app.doorloop.com/api
LISTINGS_CACHE_SECONDS=300

# ---- Abuse protection -------------------------------------------------------
RATE_LIMIT_PER_MIN=20
